# Copy to .env locally. Never commit real values.
MONITOR_DB=state/monitor.sqlite3
MONITOR_BOT_TOKEN=
MONITOR_HTTP_BACKEND=urllib
MONITOR_OWNER_ID=0
MONITOR_SOURCE_IDS=
MONITOR_CLIENT_SOURCES=
MONITOR_CLIENT_PEER_IDS=
MONITOR_CLIENT_ACCOUNT=
MONITOR_CLIENT_NETWORK=direct
MONITOR_API_ID=
MONITOR_API_HASH=
MONITOR_QUIET_START=23
MONITOR_QUIET_END=9
MONITOR_RETENTION_DAYS=30
MONITOR_URGENT_HOURS=24

# Ленты бирж и веб-мониторинга. Kwork выведен из состава 25.11.2026;
# включить заново можно только явно: feeds.py run --only kwork
MONITOR_FEEDS=fl,workspace,connect,watch
MONITOR_FEED_MAX_AGE_HOURS=24
MONITOR_FEED_NETWORK=direct

# Мост changedetection.io (страницы без RSS и API). Ключ выдаётся в
# Settings -> API на локальном экземпляре, служба слушает только 127.0.0.1.
MONITOR_WATCH_API=http://127.0.0.1:5000
MONITOR_WATCH_KEY=
MONITOR_WATCH_TAG=
MONITOR_WATCH_MIN_CHARS=40

# ИИ-помощник выключен: карточки приходят без блока «Наш отклик»,
# кнопки копирования нет, вызовов модели и расходов нет.
# Включать осознанно: поставить 1, заполнить ключ, запустить таймер.
MONITOR_AI_ENABLED=0
MONITOR_AI_MODE=draft
MONITOR_AI_MODEL=
MONITOR_AI_API_KEY=
MONITOR_AI_HOLD_MINUTES=5
MONITOR_AI_MONTHLY_CALLS=1500
